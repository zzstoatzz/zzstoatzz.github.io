---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/fira-code/latin-300.css';
import '@fontsource/fira-code/latin-400.css';
import '@fontsource/fira-code/latin-500.css';
import '../styles/globals.css';
import '../particles/particles.css';
import Shell from '../components/Shell';
import Footer from '../components/Footer';

interface Props {
    title?: string;
}

const { title = 'n8' } = Astro.props;
// '/about.html' or '/about' -> '/about'; '/index.html' -> '/'
const path = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/$/, '') || '/';
const isHome = path === '/';
// /about has its own "find me" footer
const showFooter = path !== '/about';
// the link preview, rendered at build by scripts/og.ts; the commit in the
// query makes unfurlers that cache by url fetch each deploy's frame
const commit = (import.meta.env.GITHUB_SHA as string | undefined)?.slice(0, 7);
const ogImage = new URL(`/og.png${commit ? `?v=${commit}` : ''}`, Astro.site);
const pageUrl = new URL(path, Astro.site);
---

<html lang="en" class="font-sans">
    <head>
        <meta charset="utf-8" />
        <!-- cover: draw under the notch, home indicator and iOS safari's bars -->
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="theme-color" content="#0B0B03" />
        <title>{title}</title>
        <meta name="application-name" content="n8" />
        <!-- from the home screen: run full screen, particles under the status bar -->
        <link rel="manifest" href="/manifest.webmanifest" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-title" content="n8" />
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
        <link rel="icon" href="/assets/images/stoat.png" />
        <link rel="apple-touch-icon" href="/assets/images/stoat-180.png" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="zzstoatzz.io" />
        <meta property="og:title" content={title} />
        <meta property="og:url" content={pageUrl} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="a long exposure of the homepage's particles swirling around a held touch" />
        <meta name="twitter:card" content="summary_large_image" />
        <script is:inline define:vars={{ isHome }}>
            // startup errors, kept from the first byte so a homepage that comes
            // up blank can say why: some browsers (firefox focus on ios) have
            // no console to look in
            window.__bootErrors = [];
            const keep = (msg) => window.__bootErrors.push(String(msg).slice(0, 300));
            addEventListener('error', (e) => {
                const t = e.target;
                keep(t && t !== window ? `failed to load ${t.src || t.href}` : e.message);
            }, true);
            addEventListener('unhandledrejection', (e) => keep(e.reason && (e.reason.message || e.reason)));
            if (isHome) {
                setTimeout(() => {
                    if (window.particleSystem) return;
                    const el = document.createElement('pre');
                    el.style.cssText = 'position:fixed;left:12px;right:12px;top:30%;z-index:10001;margin:0;white-space:pre-wrap;word-break:break-word;font:11px/1.5 monospace;color:rgba(255,255,255,0.55);';
                    el.textContent = ['particles did not start', ...window.__bootErrors, navigator.userAgent].join('\n');
                    document.body.appendChild(el);
                }, 8000);
            }
        </script>
        <ClientRouter />
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-SLML4CSJ70"></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', 'G-SLML4CSJ70');
        </script>
    </head>
    <body class="bg-[#0B0B03]">
        <Shell client:load transition:persist="shell" path={path} />
        <div class="relative z-20 min-h-screen flex flex-col overflow-x-hidden">
            {
                isHome ? (
                    <slot />
                ) : (
                    <>
                        {/* full page translucent backdrop */}
                        <div class="fixed inset-0 bg-[rgba(11,11,3,0.55)] backdrop-blur-[4px] z-[5] rounded-lg" />
                        <div class="relative min-h-screen flex flex-col z-10">
                            <main class="flex-grow container mx-auto px-4 py-8">
                                <slot />
                            </main>
                            {showFooter && <Footer />}
                        </div>
                    </>
                )
            }
        </div>
    </body>
</html>
